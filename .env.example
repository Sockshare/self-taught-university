# Self-Taught University — optional settings.  Copy to .env (gitignored) or export.
# The Gemini key can also be pasted in the app's Settings page (stored in the local SQLite DB).

# GEMINI_API_KEY=            # https://aistudio.google.com/app/apikey  (free tier works)
# SELF_TAUGHT_PORT=8088
# SELF_TAUGHT_DB=data/self_taught.db

# Optional: link coursework to a local Run Nexus launcher
# NEXUS_APPS_JSON=~/.config/run_nexus/apps.json
# NEXUS_PORT=5000
